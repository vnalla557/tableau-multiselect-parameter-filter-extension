<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="io.github.vnalla557.tableau-multiselect-parameter-filter-extension" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>MultiSelect Parameter</description>
    <author name="Vasu Nallasamy" email="contact@ga4powerbi.com" organization="Vasu Nallasamy" website="https://ga4powerbi.com"/>
    <min-api-version>1.6</min-api-version>
    <source-location>
      <url>https://vnalla557.github.io/tableau-multiselect-parameter-filter-extension/source/index.html</url>
    </source-location>
    <icon></icon>

    <permissions>
      <permission>full data</permission>
    </permissions>

    <context-menu>
      <configure-context-menu-item />
    </context-menu>

  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">MultiSelect Parameter</text>
    </resource>
  </resources>
</manifest>
